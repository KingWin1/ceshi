/* 通用空状态组件 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 140rpx 0;
}

.empty__icon {
  font-size: 80rpx;
}

.empty__text {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #999999;
}

.empty__btn {
  margin-top: 36rpx;
  padding: 14rpx 56rpx;
  border-radius: 34rpx;
  border: 2rpx solid #4a90d9;
  font-size: 28rpx;
  color: #4a90d9;
}
