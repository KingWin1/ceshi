/**app.wxss —— 全局样式重置**/
page {
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica,
    'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: #333;
  background: #f2f3f7;
}

button {
  padding: 0;
  margin: 0;
  border: none;
  background: none;
  line-height: inherit;
  font-size: inherit;
}

button::after {
  border: none;
}

/* 主按钮（蓝色渐变胶囊） */
.btn-primary {
  width: 480rpx;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 48rpx;
  background: linear-gradient(90deg, #3aa8f5, #4a90d9);
  color: #ffffff;
  font-size: 34rpx;
  text-align: center;
}

.btn-primary--disabled {
  opacity: 0.6;
}
