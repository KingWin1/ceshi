/* 个人中心 */
.page {
  min-height: 100vh;
  background: #f2f3f7;
  padding-bottom: 60rpx;
}

.header {
  background: linear-gradient(180deg, #4a90d9, #5fb0f0);
  padding-bottom: 120rpx;
}

.navbar {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.navbar__title {
  font-size: 36rpx;
  color: #ffffff;
  font-weight: 500;
}

.user {
  display: flex;
  align-items: center;
  padding: 20rpx 40rpx 0;
}

.user__avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.6);
  background: #ffffff;
}

.user__info {
  display: flex;
  flex-direction: column;
  margin-left: 28rpx;
}

.user__name {
  font-size: 36rpx;
  font-weight: 600;
  color: #ffffff;
}

.user__phone {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

.group {
  margin: 24rpx 30rpx 0;
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 30rpx rgba(74, 144, 217, 0.08);
}

.group__title {
  padding: 24rpx 32rpx 8rpx;
  font-size: 24rpx;
  color: #999999;
}

.cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 100rpx;
  padding: 0 32rpx;
  border-bottom: 2rpx solid #f2f3f7;
}

.cell:last-child {
  border-bottom: none;
}

.cell__label {
  font-size: 30rpx;
  color: #1a1a1a;
}

.cell__arrow {
  font-size: 40rpx;
  color: #cccccc;
}

.logout-btn {
  width: auto;
  margin: 60rpx 30rpx 0;
}

.logout-btn--plain {
  background: #ffffff;
  color: #e86a5a;
  border: 2rpx solid #e86a5a;
}
