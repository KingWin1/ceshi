<view class="page">
  <!-- 顶部渐变区：含状态栏避让 -->
  <view class="header" style="padding-top: {{statusBarHeight}}px;">
    <view class="navbar">
      <text class="navbar__title">我的</text>
    </view>
    <!-- 用户信息卡 -->
    <view class="user">
      <image class="user__avatar" src="{{icons.AVATAR_WX}}" mode="aspectFill" />
      <block wx:if="{{resident}}">
        <view class="user__info">
          <text class="user__name">{{resident.name || '小区居民'}}</text>
          <text class="user__phone">{{residentMasked}}</text>
        </view>
      </block>
      <block wx:else>
        <view class="user__info" bindtap="onGoLogin">
          <text class="user__name">点击登录</text>
          <text class="user__phone">登录后可查看账单与报修</text>
        </view>
      </block>
    </view>
  </view>

  <!-- 功能入口分组 -->
  <view class="group">
    <view class="group__title">常用服务</view>
    <view class="cell" bindtap="onGoRepair">
      <text class="cell__label">我的报修</text>
      <text class="cell__arrow">›</text>
    </view>
    <view class="cell" bindtap="onGoBill">
      <text class="cell__label">物业账单</text>
      <text class="cell__arrow">›</text>
    </view>
    <view class="cell" bindtap="onGoNotice">
      <text class="cell__label">通知公告</text>
      <text class="cell__arrow">›</text>
    </view>
  </view>

  <view class="group">
    <view class="group__title">账号设置</view>
    <view class="cell" bindtap="onGoProfile">
      <text class="cell__label">个人资料</text>
      <text class="cell__arrow">›</text>
    </view>
    <view class="cell" bindtap="onGoSettings">
      <text class="cell__label">设置</text>
      <text class="cell__arrow">›</text>
    </view>
  </view>

  <view wx:if="{{resident}}" class="btn-primary logout-btn logout-btn--plain" bindtap="onLogoutTap">退出登录</view>
</view>
