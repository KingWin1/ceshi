<view class="page">
  <!-- 顶部蓝色渐变区（含状态栏避让） -->
  <view class="header" style="padding-top: {{statusBarHeight}}px;">
    <view class="navbar">
      <image class="navbar__back" src="{{icons.BACK_WHITE}}" bindtap="onBackTap" />
      <text class="navbar__title">用户注册</text>
    </view>
  </view>

  <!-- 表单卡片 -->
  <view class="card">
    <!-- 第一步：手机号 + 验证码 -->
    <block wx:if="{{step === 1}}">
      <view class="field">
        <input class="field__input" type="number" maxlength="11" placeholder="请输入手机号"
               placeholder-class="field__ph" value="{{phone}}" bindinput="onPhoneInput" />
      </view>
      <view class="field">
        <input class="field__input" type="number" maxlength="6" placeholder="请输入验证码"
               placeholder-class="field__ph" value="{{code}}" bindinput="onCodeInput" />
        <text class="field__action {{countdown > 0 ? 'field__action--disabled' : ''}}" bindtap="onSendCodeTap">
          {{countdown > 0 ? countdown + 's后重发' : '获取验证码'}}
        </text>
      </view>
    </block>

    <!-- 第二步：密码 + 确认密码 -->
    <block wx:else>
      <view class="field">
        <input class="field__input" password="{{!pwdVisible}}" placeholder="请输入密码"
               placeholder-class="field__ph" value="{{password}}" bindinput="onPwdInput" />
        <image class="field__eye" src="{{icons.ICON_EYE}}" bindtap="onTogglePwd" />
      </view>
      <view class="field">
        <input class="field__input" password="{{!confirmVisible}}" placeholder="再次输入密码"
               placeholder-class="field__ph" value="{{confirmPassword}}" bindinput="onConfirmInput" />
        <image class="field__eye" src="{{icons.ICON_EYE}}" bindtap="onToggleConfirm" />
      </view>
    </block>
  </view>

  <!-- 用户协议 -->
  <view class="agreement">
    <view class="agreement__check {{agreed ? 'agreement__check--on' : ''}}" bindtap="onToggleAgree">
      <text wx:if="{{agreed}}" class="agreement__tick">✓</text>
    </view>
    <view class="agreement__text">
      <text>我已阅读并同意</text>
      <text class="agreement__link" catchtap="onAgreementTap">《用户使用协议》</text>
      <text>和</text>
      <text class="agreement__link" catchtap="onPrivacyTap">《隐私政策》</text>
    </view>
  </view>

  <!-- 提交按钮 -->
  <view class="btn-primary submit-btn {{loading ? 'btn-primary--disabled' : ''}}" bindtap="onSubmitTap">
    {{step === 1 ? '下一步' : '确定提交'}}
  </view>
</view>
