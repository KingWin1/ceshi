/* 设置页 */
.page {
  min-height: 100vh;
  background: #f2f3f7;
  padding-bottom: 60rpx;
}

.header {
  background: linear-gradient(180deg, #4a90d9, #5fb0f0);
  padding-bottom: 60rpx;
}

.navbar {
  position: relative;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.navbar__back {
  position: absolute;
  left: 30rpx;
  top: 22rpx;
  width: 44rpx;
  height: 44rpx;
}

.navbar__title {
  font-size: 36rpx;
  color: #ffffff;
  font-weight: 500;
}

.group {
  margin: 24rpx 30rpx 0;
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 30rpx rgba(74, 144, 217, 0.08);
}

.group__title {
  padding: 24rpx 32rpx 8rpx;
  font-size: 24rpx;
  color: #999999;
}

.cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 100rpx;
  padding: 0 32rpx;
  border-bottom: 2rpx solid #f2f3f7;
}

.cell:last-child {
  border-bottom: none;
}

.cell__label {
  font-size: 30rpx;
  color: #1a1a1a;
}

.cell__arrow {
  font-size: 40rpx;
  color: #cccccc;
}
