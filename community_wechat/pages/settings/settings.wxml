<view class="page">
  <view class="header" style="padding-top: {{statusBarHeight}}px;">
    <view class="navbar">
      <image class="navbar__back" src="{{icons.BACK_WHITE}}" bindtap="onBackTap" />
      <text class="navbar__title">设置</text>
    </view>
  </view>

  <view class="group">
    <view class="group__title">账号安全</view>
    <view class="cell" bindtap="onGoChangePwd">
      <text class="cell__label">修改密码</text>
      <text class="cell__arrow">›</text>
    </view>
  </view>

  <view class="group">
    <view class="group__title">通用</view>
    <view class="cell">
      <text class="cell__label">消息通知</text>
      <switch checked="{{notifyOn}}" color="#4a90d9" bindchange="onNotifyChange" />
    </view>
    <view class="cell" bindtap="onClearCache">
      <text class="cell__label">清除缓存</text>
      <text class="cell__arrow">›</text>
    </view>
    <view class="cell" bindtap="onCheckUpdate">
      <text class="cell__label">检查更新</text>
      <text class="cell__arrow">›</text>
    </view>
  </view>

  <view class="group">
    <view class="group__title">关于</view>
    <view class="cell" bindtap="onGoAbout">
      <text class="cell__label">关于我们</text>
      <text class="cell__arrow">›</text>
    </view>
  </view>
</view>
