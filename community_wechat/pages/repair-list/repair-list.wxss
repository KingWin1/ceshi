/* 报修列表页 */
.page {
  min-height: 100vh;
  background: #f2f3f7;
  padding-bottom: 160rpx;
}

.header {
  background: linear-gradient(180deg, #4a90d9, #5fb0f0);
  padding-bottom: 30rpx;
}

.navbar {
  position: relative;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.navbar__back {
  position: absolute;
  left: 30rpx;
  top: 22rpx;
  width: 44rpx;
  height: 44rpx;
}

.navbar__title {
  font-size: 36rpx;
  color: #ffffff;
  font-weight: 500;
}

/* 筛选标签 */
.tabs {
  display: flex;
  margin: 20rpx 30rpx 0;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 40rpx;
  padding: 6rpx;
}

.tabs__item {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 28rpx;
  color: #ffffff;
  border-radius: 34rpx;
}

.tabs__item--active {
  background: #ffffff;
  color: #4a90d9;
  font-weight: 500;
}

/* 列表卡片 */
.list {
  padding: 24rpx 30rpx 0;
}

.repair-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 30rpx rgba(74, 144, 217, 0.08);
}

.repair-card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.repair-card__type {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.repair-card__status {
  font-size: 24rpx;
  padding: 6rpx 20rpx;
  border-radius: 24rpx;
}

.repair-card__status--pending {
  color: #e6a23c;
  background: #fdf6ec;
}

.repair-card__status--doing {
  color: #4a90d9;
  background: #ecf5ff;
}

.repair-card__status--done {
  color: #67c23a;
  background: #f0f9eb;
}

.repair-card__status--cancel {
  color: #999999;
  background: #f4f4f5;
}

.repair-card__desc {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #666666;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.repair-card__foot {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 24rpx;
  color: #999999;
}

/* 加载更多 */
.load-more {
  padding: 30rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #999999;
}

/* 悬浮按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 80rpx;
  width: 110rpx;
  height: 110rpx;
  line-height: 106rpx;
  text-align: center;
  border-radius: 50%;
  background: linear-gradient(135deg, #3aa8f5, #4a90d9);
  color: #ffffff;
  font-size: 60rpx;
  box-shadow: 0 10rpx 30rpx rgba(74, 144, 217, 0.4);
}
