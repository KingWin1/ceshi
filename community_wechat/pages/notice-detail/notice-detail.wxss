/* 公告详情页 */
.page {
  min-height: 100vh;
  background: #f2f3f7;
  padding-bottom: 60rpx;
}

.header {
  background: linear-gradient(180deg, #4a90d9, #5fb0f0);
  padding-bottom: 60rpx;
}

.navbar {
  position: relative;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.navbar__back {
  position: absolute;
  left: 30rpx;
  top: 22rpx;
  width: 44rpx;
  height: 44rpx;
}

.navbar__title {
  font-size: 36rpx;
  color: #ffffff;
  font-weight: 500;
}

.content {
  margin: -40rpx 30rpx 0;
}

.article {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 8rpx 30rpx rgba(74, 144, 217, 0.08);
}

.article__title {
  display: block;
  font-size: 38rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.5;
}

.article__meta {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  padding-bottom: 24rpx;
  border-bottom: 2rpx solid #f2f3f7;
  font-size: 24rpx;
  color: #999999;
}

.article__source {
  margin-right: 30rpx;
}

.article__body {
  padding-top: 30rpx;
}

.article__paragraph {
  display: block;
  font-size: 30rpx;
  color: #333333;
  line-height: 1.8;
  margin-bottom: 24rpx;
  text-align: justify;
}

.article__image {
  width: 100%;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}

.loading-tip {
  margin-top: 200rpx;
  text-align: center;
  font-size: 28rpx;
  color: #999999;
}
