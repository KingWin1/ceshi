/* 账单列表页 */
.page {
  min-height: 100vh;
  background: #f2f3f7;
  padding-bottom: 60rpx;
}

.header {
  background: linear-gradient(180deg, #4a90d9, #5fb0f0);
  padding-bottom: 30rpx;
}

.navbar {
  position: relative;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.navbar__back {
  position: absolute;
  left: 30rpx;
  top: 22rpx;
  width: 44rpx;
  height: 44rpx;
}

.navbar__title {
  font-size: 36rpx;
  color: #ffffff;
  font-weight: 500;
}

.navbar__extra {
  position: absolute;
  right: 30rpx;
  top: 26rpx;
  font-size: 26rpx;
  color: #ffffff;
}

/* 待缴汇总 */
.summary {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0 10rpx;
}

.summary__label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.summary__amount {
  margin-top: 8rpx;
  font-size: 64rpx;
  font-weight: 600;
  color: #ffffff;
}

/* 筛选标签 */
.tabs {
  display: flex;
  margin: 20rpx 30rpx 0;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 40rpx;
  padding: 6rpx;
}

.tabs__item {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 28rpx;
  color: #ffffff;
  border-radius: 34rpx;
}

.tabs__item--active {
  background: #ffffff;
  color: #4a90d9;
  font-weight: 500;
}

/* 账单卡片 */
.list {
  padding: 24rpx 30rpx 0;
}

.bill-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 30rpx rgba(74, 144, 217, 0.08);
}

.bill-card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.bill-card__month {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.bill-card__status {
  font-size: 24rpx;
  color: #e6a23c;
  background: #fdf6ec;
  padding: 6rpx 20rpx;
  border-radius: 24rpx;
}

.bill-card__status--paid {
  color: #67c23a;
  background: #f0f9eb;
}

.bill-card__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}

.bill-card__label {
  font-size: 28rpx;
  color: #666666;
}

.bill-card__amount {
  font-size: 36rpx;
  font-weight: 600;
  color: #e86a5a;
}

.bill-card__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}

.bill-card__deadline {
  font-size: 24rpx;
  color: #999999;
}

.bill-card__btn {
  padding: 10rpx 32rpx;
  border-radius: 30rpx;
  background: linear-gradient(90deg, #3aa8f5, #4a90d9);
  color: #ffffff;
  font-size: 26rpx;
}

/* 加载更多 */
.load-more {
  padding: 30rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #999999;
}
