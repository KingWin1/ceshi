/* 账单详情页 */
.page {
  min-height: 100vh;
  background: #f2f3f7;
  padding-bottom: 180rpx;
}

.header {
  background: linear-gradient(180deg, #4a90d9, #5fb0f0);
  padding-bottom: 60rpx;
}

.navbar {
  position: relative;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.navbar__back {
  position: absolute;
  left: 30rpx;
  top: 22rpx;
  width: 44rpx;
  height: 44rpx;
}

.navbar__title {
  font-size: 36rpx;
  color: #ffffff;
  font-weight: 500;
}

.content {
  margin: -40rpx 30rpx 0;
}

/* 金额卡片 */
.amount-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 48rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 30rpx rgba(74, 144, 217, 0.08);
}

.amount-card__label {
  font-size: 28rpx;
  color: #666666;
}

.amount-card__value {
  margin-top: 16rpx;
  font-size: 72rpx;
  font-weight: 600;
  color: #e86a5a;
}

.amount-card__status {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #e6a23c;
  background: #fdf6ec;
  padding: 6rpx 24rpx;
  border-radius: 24rpx;
}

/* 通用卡片 */
.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 30rpx rgba(74, 144, 217, 0.08);
}

.card__title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f2f3f7;
}

/* 费用明细行 */
.fee-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  font-size: 28rpx;
}

.fee-row__name {
  color: #666666;
}

.fee-row__value {
  color: #1a1a1a;
}

.fee-row--total {
  padding-top: 24rpx;
  border-top: 2rpx dashed #ebeef5;
}

.fee-row--total .fee-row__name,
.fee-row--total .fee-row__value {
  font-weight: 600;
  color: #1a1a1a;
}

/* 信息行 */
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 24rpx;
  font-size: 28rpx;
}

.info-row__label {
  color: #999999;
}

.info-row__value {
  color: #1a1a1a;
}

/* 底部缴费按钮 */
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 30rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.pay-btn {
  width: 100%;
}

.loading-tip {
  margin-top: 200rpx;
  text-align: center;
  font-size: 28rpx;
  color: #999999;
}
