<view class="page">
  <view class="header" style="padding-top: {{statusBarHeight}}px;">
    <view class="navbar">
      <text class="navbar__title">小区通</text>
    </view>
  </view>

  <view class="card">
    <block wx:if="{{resident}}">
      <view class="card__title">欢迎回来，{{resident.name}}</view>
      <view class="card__row">手机号：{{residentMasked}}</view>
    </block>
    <block wx:else>
      <view class="card__title">尚未登录</view>
      <view class="card__row">绑定居民账号后即可查看账单、报修进度</view>
    </block>
  </view>

  <view wx:if="{{!resident}}" class="btn-primary enter-btn" bindtap="onGoLogin">去登录</view>
  <view wx:else class="btn-primary enter-btn enter-btn--plain" bindtap="onLogoutTap">退出登录</view>
</view>
