/* 提交报修页 */
.page {
  min-height: 100vh;
  background: #f2f3f7;
  padding-bottom: 60rpx;
}

.header {
  background: linear-gradient(180deg, #4a90d9, #5fb0f0);
  padding-bottom: 60rpx;
}

.navbar {
  position: relative;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.navbar__back {
  position: absolute;
  left: 30rpx;
  top: 22rpx;
  width: 44rpx;
  height: 44rpx;
}

.navbar__title {
  font-size: 36rpx;
  color: #ffffff;
  font-weight: 500;
}

.form {
  margin: -40rpx 30rpx 0;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 8rpx 30rpx rgba(74, 144, 217, 0.08);
}

.form__label {
  font-size: 28rpx;
  color: #1a1a1a;
  font-weight: 500;
  margin-bottom: 20rpx;
}

/* 类型标签 */
.types {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 40rpx;
}

.types__item {
  width: calc((100% - 40rpx) / 3);
  height: 72rpx;
  line-height: 72rpx;
  margin: 0 20rpx 20rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #666666;
  background: #f2f3f7;
  border-radius: 12rpx;
  border: 2rpx solid #f2f3f7;
}

.types__item:nth-child(3n) {
  margin-right: 0;
}

.types__item--active {
  color: #4a90d9;
  background: #ecf5ff;
  border-color: #4a90d9;
}

/* 描述输入 */
.textarea-wrap {
  position: relative;
  margin-bottom: 40rpx;
}

.textarea {
  width: 100%;
  height: 220rpx;
  padding: 24rpx;
  box-sizing: border-box;
  background: #f7f8fa;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.textarea__placeholder {
  color: #bbbbbb;
}

.textarea__count {
  position: absolute;
  right: 24rpx;
  bottom: 20rpx;
  font-size: 24rpx;
  color: #bbbbbb;
}

/* 图片选择 */
.images {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 40rpx;
}

.images__item {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  margin: 0 20rpx 20rpx 0;
}

.images__pic {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.images__del {
  position: absolute;
  right: -14rpx;
  top: -14rpx;
  width: 44rpx;
  height: 44rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.6);
  color: #ffffff;
  font-size: 32rpx;
}

.images__add {
  width: 180rpx;
  height: 180rpx;
  line-height: 176rpx;
  text-align: center;
  border-radius: 12rpx;
  border: 2rpx dashed #cccccc;
  color: #bbbbbb;
  font-size: 60rpx;
  box-sizing: border-box;
}

/* 联系电话 */
.input {
  height: 88rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  background: #f7f8fa;
  border-radius: 12rpx;
  font-size: 28rpx;
  margin-bottom: 60rpx;
}

.input__placeholder {
  color: #bbbbbb;
}

/* 提交按钮 */
.submit {
  width: 100%;
}
