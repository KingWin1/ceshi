<view class="page">
  <view class="header" style="padding-top: {{statusBarHeight}}px;">
    <view class="navbar">
      <image class="navbar__back" src="{{icons.BACK_WHITE}}" bindtap="onBackTap" />
      <text class="navbar__title">家庭成员</text>
    </view>
  </view>

  <view class="list">
    <view class="member" wx:for="{{list}}" wx:key="id">
      <image class="member__avatar" src="{{item.gender === 2 ? icons.AVATAR_FEMALE : icons.AVATAR_WX}}" />
      <view class="member__body">
        <view class="member__top">
          <text class="member__name">{{item.name}}</text>
          <text class="member__role">{{item.roleName}}</text>
        </view>
        <text class="member__phone">{{item.phoneMasked}}</text>
      </view>
      <text class="member__del" wx:if="{{item.role !== 1}}" data-id="{{item.id}}" data-name="{{item.name}}" catchtap="onDeleteTap">删除</text>
    </view>

    <empty wx:if="{{!loading && list.length === 0}}" text="暂无家庭成员" />
  </view>

  <view class="fab" bindtap="onGoAdd">＋</view>
</view>
