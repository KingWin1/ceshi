<view class="page">
  <view class="header" style="padding-top: {{statusBarHeight}}px;">
    <view class="navbar">
      <image class="navbar__back" src="{{icons.BACK_WHITE}}" bindtap="onBackTap" />
      <text class="navbar__title">关于我们</text>
    </view>
  </view>

  <view class="card">
    <view class="logo">
      <view class="logo__mark">小区通</view>
      <text class="logo__version">v{{version}}</text>
    </view>
    <view class="intro">
      <text class="intro__title">小区通</text>
      <text class="intro__desc">一站式社区生活服务平台，提供物业缴费、在线报修、通知公告、访客通行等便民服务，让社区生活更省心。</text>
    </view>
  </view>

  <view class="group">
    <view class="cell" bindtap="onGoAgreement">
      <text class="cell__label">用户协议</text>
      <text class="cell__arrow">›</text>
    </view>
    <view class="cell" bindtap="onGoPrivacy">
      <text class="cell__label">隐私政策</text>
      <text class="cell__arrow">›</text>
    </view>
    <view class="cell" bindtap="onCopyContact">
      <text class="cell__label">客服电话</text>
      <text class="cell__value">{{contactPhone}}</text>
    </view>
  </view>

  <view class="footer">
    <text class="footer__text">© 2026 小区通 · 用心服务每一位居民</text>
  </view>
</view>
