/* 账号登录页样式 */
.page {
  min-height: 100vh;
  background: #f2f3f7;
}

/* 顶部渐变区 */
.header {
  background: linear-gradient(180deg, #4a90d9, #5fb0f0);
  padding-bottom: 160rpx;
}

.navbar {
  position: relative;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.navbar__back {
  position: absolute;
  left: 30rpx;
  top: 22rpx;
  width: 44rpx;
  height: 44rpx;
}

.navbar__title {
  font-size: 36rpx;
  color: #ffffff;
  font-weight: 500;
}

/* 登录卡片（上浮覆盖渐变区底部） */
.card {
  position: relative;
  margin: -100rpx 30rpx 0;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 20rpx 40rpx 10rpx;
  box-shadow: 0 8rpx 30rpx rgba(74, 144, 217, 0.12);
}

/* Tab */
.tabs {
  display: flex;
  align-items: center;
  height: 110rpx;
}

.tabs__item {
  flex: 1;
  line-height: 1.4;
  transition: font-size 0.25s ease, color 0.25s ease;
}

/* 输入行 */
.field {
  display: flex;
  align-items: center;
  height: 110rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.field:last-child {
  border-bottom: none;
}

.field__input {
  flex: 1;
  font-size: 30rpx;
  color: #333333;
}

.field__ph {
  color: #bfbfbf;
  font-size: 30rpx;
}

.field__action {
  font-size: 30rpx;
  color: #4a90d9;
  padding-left: 24rpx;
}

.field__action--disabled {
  color: #b8c7d9;
}

.field__eye {
  width: 44rpx;
  height: 44rpx;
  padding-left: 20rpx;
}

/* 登录按钮 */
.login-btn {
  margin: 70rpx auto 0;
}

/* 底部入口 */
.footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 70rpx 70rpx 0;
}

.footer__link {
  font-size: 30rpx;
  color: #333333;
}
