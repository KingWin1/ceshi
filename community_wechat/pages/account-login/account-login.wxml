<view class="page">
  <!-- 顶部蓝色渐变区（含状态栏避让） -->
  <view class="header" style="padding-top: {{statusBarHeight}}px;">
    <view class="navbar">
      <image class="navbar__back" src="{{icons.BACK_WHITE}}" bindtap="onBackTap" />
      <text class="navbar__title">登录</text>
    </view>
  </view>

  <!-- 登录卡片 -->
  <view class="card">
    <!-- Tab 切换 -->
    <view class="tabs">
      <view class="tabs__item" style="text-align: {{activeTab === 'sms' ? 'center' : 'left'}}; font-size: {{activeTab === 'sms' ? 36 : 30}}rpx; font-weight: {{activeTab === 'sms' ? 700 : 400}}; color: {{activeTab === 'sms' ? '#1a1a1a' : '#666666'}}" bindtap="onTabSms">验证码登录</view>
      <view class="tabs__item" style="text-align: {{activeTab === 'pwd' ? 'center' : 'right'}}; font-size: {{activeTab === 'pwd' ? 36 : 30}}rpx; font-weight: {{activeTab === 'pwd' ? 700 : 400}}; color: {{activeTab === 'pwd' ? '#1a1a1a' : '#666666'}}" bindtap="onTabPwd">密码登录</view>
    </view>

    <!-- 手机号 -->
    <view class="field">
      <input class="field__input" type="number" maxlength="11" placeholder="请输入手机号"
             placeholder-class="field__ph" value="{{phone}}" bindinput="onPhoneInput" />
    </view>

    <!-- 验证码登录 -->
    <block wx:if="{{activeTab === 'sms'}}">
      <view class="field">
        <input class="field__input" type="number" maxlength="6" placeholder="请输入验证码"
               placeholder-class="field__ph" value="{{code}}" bindinput="onCodeInput" />
        <text class="field__action {{countdown > 0 ? 'field__action--disabled' : ''}}" bindtap="onSendCodeTap">
          {{countdown > 0 ? countdown + 's后重发' : '获取验证码'}}
        </text>
      </view>
    </block>

    <!-- 密码登录 -->
    <block wx:else>
      <view class="field">
        <input class="field__input" password="{{!pwdVisible}}" placeholder="请输入密码"
               placeholder-class="field__ph" value="{{password}}" bindinput="onPwdInput" />
        <image class="field__eye" src="{{icons.ICON_EYE}}" bindtap="onTogglePwd" />
      </view>
    </block>
  </view>

  <!-- 登录按钮 -->
  <view class="btn-primary login-btn {{loading ? 'btn-primary--disabled' : ''}}" bindtap="onLoginTap">登录</view>

  <!-- 底部入口：左忘记密码 右立即注册 -->
  <view class="footer">
    <text class="footer__link" bindtap="onForgotTap">忘记密码？</text>
    <text class="footer__link" bindtap="onRegisterTap">没有账号，立即注册</text>
  </view>
</view>
