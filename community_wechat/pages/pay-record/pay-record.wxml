<view class="page">
  <view class="header" style="padding-top: {{statusBarHeight}}px;">
    <view class="navbar">
      <image class="navbar__back" src="{{icons.BACK_WHITE}}" bindtap="onBackTap" />
      <text class="navbar__title">缴费记录</text>
    </view>
  </view>

  <view class="list">
    <view class="record" wx:for="{{list}}" wx:key="id">
      <view class="record__left">
        <text class="record__name">{{item.itemName}}</text>
        <text class="record__time">{{item.payTime}}</text>
      </view>
      <view class="record__right">
        <text class="record__amount">-¥{{item.amount}}</text>
        <text class="record__way">{{item.payWayName}}</text>
      </view>
    </view>

    <empty wx:if="{{!loading && list.length === 0}}" text="暂无缴费记录" />

    <view class="load-more" wx:if="{{list.length > 0}}">
      <text>{{loading ? '加载中...' : (noMore ? '没有更多了' : '上拉加载更多')}}</text>
    </view>
  </view>
</view>
