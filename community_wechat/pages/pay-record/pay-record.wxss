/* 缴费记录页 */
.page {
  min-height: 100vh;
  background: #f2f3f7;
  padding-bottom: 60rpx;
}

.header {
  background: linear-gradient(180deg, #4a90d9, #5fb0f0);
  padding-bottom: 60rpx;
}

.navbar {
  position: relative;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.navbar__back {
  position: absolute;
  left: 30rpx;
  top: 22rpx;
  width: 44rpx;
  height: 44rpx;
}

.navbar__title {
  font-size: 36rpx;
  color: #ffffff;
  font-weight: 500;
}

.list {
  margin: -40rpx 30rpx 0;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 0 32rpx;
  box-shadow: 0 8rpx 30rpx rgba(74, 144, 217, 0.08);
}

.record {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 0;
  border-bottom: 2rpx solid #f2f3f7;
}

.record:last-of-type {
  border-bottom: none;
}

.record__left {
  display: flex;
  flex-direction: column;
}

.record__name {
  font-size: 30rpx;
  color: #1a1a1a;
}

.record__time {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999999;
}

.record__right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.record__amount {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.record__way {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999999;
}

.load-more {
  padding: 30rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #999999;
}
