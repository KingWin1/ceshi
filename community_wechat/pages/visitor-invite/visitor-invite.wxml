<view class="page">
  <view class="header" style="padding-top: {{statusBarHeight}}px;">
    <view class="navbar">
      <image class="navbar__back" src="{{icons.BACK_WHITE}}" bindtap="onBackTap" />
      <text class="navbar__title">访客邀请</text>
      <text class="navbar__extra" bindtap="onGoRecord">访客记录</text>
    </view>
  </view>

  <!-- 邀请结果 -->
  <view class="result" wx:if="{{invite}}">
    <view class="result__card">
      <text class="result__tip">请让访客向门岗出示以下通行码</text>
      <view class="qrcode">
        <text class="qrcode__code">{{invite.code}}</text>
      </view>
      <view class="result__row">
        <text class="result__label">访客姓名</text>
        <text class="result__value">{{invite.visitorName}}</text>
      </view>
      <view class="result__row">
        <text class="result__label">有效期至</text>
        <text class="result__value">{{invite.expireTime}}</text>
      </view>
      <button class="btn-primary result__btn" bindtap="onReset">再邀请一位</button>
    </view>
  </view>

  <!-- 邀请表单 -->
  <view class="form" wx:else>
    <view class="field">
      <text class="field__label">访客姓名</text>
      <input class="field__input" placeholder="请输入访客姓名" placeholder-class="field__ph" value="{{visitorName}}" bindinput="onNameInput" />
    </view>
    <view class="field">
      <text class="field__label">访客手机</text>
      <input class="field__input" type="number" maxlength="11" placeholder="请输入访客手机号" placeholder-class="field__ph" value="{{visitorPhone}}" bindinput="onPhoneInput" />
    </view>
    <view class="field">
      <text class="field__label">来访事由</text>
      <input class="field__input" placeholder="如：探亲访友" placeholder-class="field__ph" value="{{reason}}" bindinput="onReasonInput" />
    </view>
    <view class="field field--col">
      <text class="field__label">有效期</text>
      <view class="days">
        <view
          class="days__item {{validDays === item.value ? 'days__item--active' : ''}}"
          wx:for="{{dayOptions}}"
          wx:key="value"
          data-value="{{item.value}}"
          bindtap="onDayTap"
        >{{item.label}}</view>
      </view>
    </view>

    <button class="btn-primary submit {{submitting ? 'btn-primary--disabled' : ''}}" bindtap="onSubmit">
      {{submitting ? '生成中...' : '生成通行码'}}
    </button>
  </view>
</view>
