/* 绑定用户信息页（复用登录页视觉） */
.page {
  min-height: 100vh;
  background: #f2f3f7;
}

.header {
  background: linear-gradient(180deg, #4a90d9, #5fb0f0);
  padding-bottom: 160rpx;
}

.navbar {
  position: relative;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.navbar__back {
  position: absolute;
  left: 30rpx;
  top: 22rpx;
  width: 44rpx;
  height: 44rpx;
}

.navbar__title {
  font-size: 36rpx;
  color: #ffffff;
  font-weight: 500;
}

.header__tip {
  text-align: center;
  color: rgba(255, 255, 255, 0.9);
  font-size: 26rpx;
  padding: 20rpx 0 40rpx;
}

.card {
  position: relative;
  margin: -100rpx 30rpx 0;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 10rpx 40rpx;
  box-shadow: 0 8rpx 30rpx rgba(74, 144, 217, 0.12);
}

.field {
  display: flex;
  align-items: center;
  height: 120rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.field:last-child {
  border-bottom: none;
}

.field__input {
  flex: 1;
  font-size: 30rpx;
  color: #333333;
}

.field__ph {
  color: #bfbfbf;
  font-size: 30rpx;
}

.field__action {
  font-size: 30rpx;
  color: #4a90d9;
  padding-left: 24rpx;
}

.field__action--disabled {
  color: #b8c7d9;
}

.submit-btn {
  margin: 80rpx auto 0;
}
