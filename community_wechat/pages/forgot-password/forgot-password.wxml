<view class="page">
  <!-- 顶部白色导航栏（含状态栏避让） -->
  <view class="header" style="padding-top: {{statusBarHeight}}px;">
    <view class="navbar">
      <view class="navbar__left" bindtap="onBackTap">
        <image class="navbar__back" src="{{icons.BACK_DARK}}" />
        <text class="navbar__back-text">返回</text>
      </view>
      <text class="navbar__title">忘记密码</text>
    </view>
  </view>

  <!-- 表单区 -->
  <view class="form">
    <view class="field">
      <image class="field__icon" src="{{icons.ICON_PHONE}}" />
      <input class="field__input" type="number" maxlength="11" placeholder="请输入手机号"
             placeholder-class="field__ph" value="{{phone}}" bindinput="onPhoneInput" />
    </view>

    <view class="field">
      <image class="field__icon" src="{{icons.ICON_LOCK_RED}}" />
      <input class="field__input" type="number" maxlength="6" placeholder="输入验证码"
             placeholder-class="field__ph" value="{{code}}" bindinput="onCodeInput" />
      <text class="field__action {{countdown > 0 ? 'field__action--disabled' : ''}}" bindtap="onSendCodeTap">
        {{countdown > 0 ? countdown + 's后重发' : '获取验证码'}}
      </text>
    </view>

    <view class="field">
      <image class="field__icon" src="{{icons.ICON_LOCK_GREEN}}" />
      <input class="field__input" password="{{!pwdVisible}}" placeholder="输入6-12位的新密码"
             placeholder-class="field__ph" value="{{password}}" bindinput="onPwdInput" />
      <image class="field__eye" src="{{icons.ICON_EYE}}" bindtap="onTogglePwd" />
    </view>
  </view>

  <view class="btn-primary submit-btn {{loading ? 'btn-primary--disabled' : ''}}" bindtap="onSubmitTap">下一步</view>
</view>
