/* 个人资料编辑 */
.page {
  min-height: 100vh;
  background: #f2f3f7;
  padding-bottom: 60rpx;
}

.header {
  background: linear-gradient(180deg, #4a90d9, #5fb0f0);
  padding-bottom: 60rpx;
}

.navbar {
  position: relative;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.navbar__back {
  position: absolute;
  left: 30rpx;
  top: 22rpx;
  width: 44rpx;
  height: 44rpx;
}

.navbar__title {
  font-size: 36rpx;
  color: #ffffff;
  font-weight: 500;
}

.card {
  margin: 24rpx 30rpx 0;
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 30rpx rgba(74, 144, 217, 0.08);
}

/* 头像行（button 重置样式） */
.avatar-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 120rpx;
  padding: 0 32rpx;
  margin: 0;
  background: #ffffff;
  border-radius: 0;
  border-bottom: 2rpx solid #f2f3f7;
  line-height: 120rpx;
  text-align: left;
}

.avatar-row__label {
  font-size: 30rpx;
  color: #1a1a1a;
}

.avatar-row__right {
  display: flex;
  align-items: center;
}

.avatar-row__img {
  width: 88rpx;
  height: 88rpx;
  border-radius: 16rpx;
  background: #f2f3f7;
}

.cell__arrow {
  margin-left: 16rpx;
  font-size: 40rpx;
  color: #cccccc;
}

.field {
  display: flex;
  align-items: center;
  height: 110rpx;
  padding: 0 32rpx;
  border-bottom: 2rpx solid #f2f3f7;
}

.field:last-child {
  border-bottom: none;
}

.field__label {
  width: 140rpx;
  font-size: 30rpx;
  color: #1a1a1a;
}

.field__input {
  flex: 1;
  font-size: 30rpx;
  color: #333333;
}

.field__ph {
  color: #bfbfbf;
  font-size: 30rpx;
}

.field__static {
  flex: 1;
  font-size: 30rpx;
  color: #999999;
}

.field__radios {
  flex: 1;
  display: flex;
  align-items: center;
}

.radio {
  display: flex;
  align-items: center;
  margin-right: 48rpx;
  font-size: 28rpx;
  color: #333333;
}

.submit-btn {
  margin: 70rpx auto 0;
}
