<view class="page">
  <view class="header" style="padding-top: {{statusBarHeight}}px;">
    <view class="navbar">
      <image class="navbar__back" src="{{icons.BACK_WHITE}}" bindtap="onBackTap" />
      <text class="navbar__title">个人资料</text>
    </view>
  </view>

  <view class="card">
    <button class="avatar-row" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <text class="avatar-row__label">头像</text>
      <view class="avatar-row__right">
        <image class="avatar-row__img" src="{{avatar || icons.AVATAR_WX}}" mode="aspectFill" />
        <text class="cell__arrow">›</text>
      </view>
    </button>

    <view class="field">
      <text class="field__label">姓名</text>
      <input class="field__input" placeholder="请输入姓名" placeholder-class="field__ph"
             value="{{name}}" maxlength="20" bindinput="onNameInput" />
    </view>

    <view class="field">
      <text class="field__label">手机号</text>
      <text class="field__static">{{phoneMasked || '未绑定'}}</text>
    </view>

    <view class="field">
      <text class="field__label">性别</text>
      <radio-group class="field__radios" bindchange="onGenderChange">
        <label class="radio"><radio value="1" color="#4a90d9" checked="{{gender === 1}}" />男</label>
        <label class="radio"><radio value="2" color="#4a90d9" checked="{{gender === 2}}" />女</label>
      </radio-group>
    </view>
  </view>

  <view class="btn-primary submit-btn {{loading ? 'btn-primary--disabled' : ''}}" bindtap="onSubmitTap">
    {{loading ? '保存中...' : '保存'}}
  </view>
</view>
