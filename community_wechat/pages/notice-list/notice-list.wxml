<view class="page">
  <view class="header" style="padding-top: {{statusBarHeight}}px;">
    <view class="navbar">
      <image class="navbar__back" src="{{icons.BACK_WHITE}}" bindtap="onBackTap" />
      <text class="navbar__title">小区公告</text>
    </view>
  </view>

  <view class="list">
    <view class="notice-item" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="onGoDetail">
      <view class="notice-item__top">
        <text class="notice-item__tag" wx:if="{{item.isTop === 1}}">置顶</text>
        <text class="notice-item__title">{{item.title}}</text>
      </view>
      <view class="notice-item__summary">{{item.summary}}</view>
      <view class="notice-item__foot">
        <text class="notice-item__source">{{item.source || '物业管理处'}}</text>
        <text class="notice-item__time">{{item.publishTime}}</text>
      </view>
    </view>

    <empty wx:if="{{!loading && list.length === 0}}" text="暂无公告" />

    <view class="load-more" wx:if="{{list.length > 0}}">
      <text>{{loading ? '加载中...' : (noMore ? '没有更多了' : '上拉加载更多')}}</text>
    </view>
  </view>
</view>
