/* 公告列表页 */
.page {
  min-height: 100vh;
  background: #f2f3f7;
  padding-bottom: 60rpx;
}

.header {
  background: linear-gradient(180deg, #4a90d9, #5fb0f0);
  padding-bottom: 60rpx;
}

.navbar {
  position: relative;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.navbar__back {
  position: absolute;
  left: 30rpx;
  top: 22rpx;
  width: 44rpx;
  height: 44rpx;
}

.navbar__title {
  font-size: 36rpx;
  color: #ffffff;
  font-weight: 500;
}

.list {
  margin: -40rpx 30rpx 0;
}

/* 公告条目 */
.notice-item {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 30rpx rgba(74, 144, 217, 0.08);
}

.notice-item__top {
  display: flex;
  align-items: center;
}

.notice-item__tag {
  flex-shrink: 0;
  margin-right: 12rpx;
  padding: 2rpx 14rpx;
  font-size: 22rpx;
  color: #ffffff;
  background: #e86a5a;
  border-radius: 8rpx;
}

.notice-item__title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.notice-item__summary {
  margin-top: 14rpx;
  font-size: 28rpx;
  color: #666666;
  line-height: 1.6;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.notice-item__foot {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 24rpx;
  color: #999999;
}

.load-more {
  padding: 30rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #999999;
}
