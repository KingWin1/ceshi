<view class="page">
  <view class="header" style="padding-top: {{statusBarHeight}}px;">
    <view class="navbar">
      <image class="navbar__back" src="{{icons.BACK_WHITE}}" bindtap="onBackTap" />
      <text class="navbar__title">添加成员</text>
    </view>
  </view>

  <view class="form">
    <view class="field">
      <text class="field__label">姓名</text>
      <input class="field__input" placeholder="请输入成员姓名" placeholder-class="field__ph" value="{{name}}" bindinput="onNameInput" />
    </view>

    <view class="field">
      <text class="field__label">手机号</text>
      <input class="field__input" type="number" maxlength="11" placeholder="请输入手机号" placeholder-class="field__ph" value="{{phone}}" bindinput="onPhoneInput" />
    </view>

    <view class="field">
      <text class="field__label">身份关系</text>
      <picker class="field__picker" range="{{roles}}" range-key="label" value="{{roleIndex}}" bindchange="onRoleChange">
        <view class="picker-value {{roles[roleIndex].value ? '' : 'picker-value--ph'}}">
          {{roles[roleIndex].label}}
        </view>
      </picker>
    </view>

    <view class="field">
      <text class="field__label">性别</text>
      <view class="genders">
        <view class="genders__item {{gender === 1 ? 'genders__item--active' : ''}}" data-value="1" bindtap="onGenderTap">男</view>
        <view class="genders__item {{gender === 2 ? 'genders__item--active' : ''}}" data-value="2" bindtap="onGenderTap">女</view>
      </view>
    </view>

    <button class="btn-primary submit {{submitting ? 'btn-primary--disabled' : ''}}" bindtap="onSubmit">
      {{submitting ? '提交中...' : '保存'}}
    </button>
  </view>
</view>
