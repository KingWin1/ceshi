<view class="page">
  <view class="header" style="padding-top: {{statusBarHeight}}px;">
    <view class="navbar">
      <image class="navbar__back" src="{{icons.BACK_WHITE}}" bindtap="onBackTap" />
      <text class="navbar__title">访客记录</text>
    </view>
  </view>

  <view class="list">
    <view class="visit" wx:for="{{list}}" wx:key="id">
      <view class="visit__head">
        <text class="visit__name">{{item.visitorName}}</text>
        <text class="visit__status visit__status--{{item.statusKey}}">{{item.statusName}}</text>
      </view>
      <view class="visit__row">
        <text class="visit__label">来访事由</text>
        <text class="visit__value">{{item.reason || '-'}}</text>
      </view>
      <view class="visit__row">
        <text class="visit__label">有效期至</text>
        <text class="visit__value">{{item.expireTime}}</text>
      </view>
      <view class="visit__row">
        <text class="visit__label">邀请时间</text>
        <text class="visit__value">{{item.createTime}}</text>
      </view>
    </view>

    <empty wx:if="{{!loading && list.length === 0}}" text="暂无访客记录" />

    <view class="load-more" wx:if="{{list.length > 0}}">
      <text>{{loading ? '加载中...' : (noMore ? '没有更多了' : '上拉加载更多')}}</text>
    </view>
  </view>
</view>
